{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserRegistered",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "userId",
    "email"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "UserRegistered"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  }
}