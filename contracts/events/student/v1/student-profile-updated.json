{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudentProfileUpdated",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "studentId",
    "userId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "StudentProfileUpdated"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "studentId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    }
  }
}